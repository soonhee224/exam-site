---
import { getCollection } from 'astro:content';

// 전자공학개론(국가직, 지방직) 및 무선공학개론(국가직) 구성
const subjects = [
  {
    id: 'electronics',
    name: '전자공학개론',
    types: [
      { id: 'national', name: '국가직' },
      { id: 'local', name: '지방직' },
    ],
  },
  {
    id: 'wireless',
    name: '무선공학개론',
    types: [
      { id: 'national', name: '국가직' },
    ],
  },
];

const baseYears = Array.from({ length: 2026 - 2007 + 1 }, (_, i) => 2026 - i);

// 과목 및 직렬별 유효 연도 반환 함수
const getYearsForSubjectAndType = (subjectId: string, typeId: string) => {
  // 무선공학개론은 2026년도 및 2025년도 문제 노출
  if (subjectId === 'wireless') {
    return [2026, 2025, 2024, 2023, 2022, 2021, 2020, 2019, 2018];
  }
  // 전자공학개론 지방직은 2007, 2008, 2013 제외
  if (typeId === 'local') {
    const excluded = [2007, 2008, 2013];
    return baseYears.filter((yr) => !excluded.includes(yr));
  }
  return baseYears;
};

// Content Collections에서 등록된 모든 문제 가져오기
const allExams = await getCollection('exams');

// 클라이언트 사이드 검색을 위한 가벼운 데이터셋 구성
const searchIndex = allExams.map((exam) => ({
  id: exam.id || exam.slug,
  title: exam.data.title,
  year: exam.data.year,
  examType: exam.data.examType,
  questionNumber: exam.data.questionNumber,
  subject: exam.data.subject,
  chapter: exam.data.chapter || '',
  body: exam.body || '',
}));
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>전자직·통신직 공무원 기출문제 해설</title>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6442138456527170"
     crossorigin="anonymous"></script>
    <style>
      :root {
        --primary: #2563eb;
        --bg-color: #f8fafc;
        --card-bg: #ffffff;
        --text-main: #0f172a;
        --text-sub: #64748b;
        --border-color: #e2e8f0;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background-color: var(--bg-color);
        color: var(--text-main);
        padding: 2rem 1rem;
      }
      .container { max-width: 900px; margin: 0 auto; }
      header { text-align: center; margin-bottom: 2rem; }
      header h1 {
        /* 모바일 화면 폭에 맞춰 1.25rem ~ 1.8rem 사이로 자동 스케일링 */
        font-size: clamp(1.25rem, 4.5vw, 1.8rem);
        font-weight: 800;
        line-height: 1.3;
        white-space: nowrap; /* 좁은 모바일 화면에서도 절대 줄바꿈되지 않도록 강제 */
      }

      /* 메인 화면 링크 스타일 */
      .site-title {
        color: #1e293b;
        text-decoration: none;
        display: inline-block;
        transition: color 0.15s ease;
      }
      .site-title:hover {
        color: var(--primary); /* 마우스 올렸을 때 은은한 파란색 전환 */
      }

/* 검색창 컨테이너 */
.search-wrapper {
  display: flex;
  align-items: stretch; /* 검색창과 버튼의 높이를 완벽히 동일하게 맞춤 */
  gap: 0.5rem;
  margin-bottom: 2rem;
}

    /* 검색 입력창 */
    .search-input {
      flex: 1;
      padding: 0.85rem 1.2rem;
      font-size: 1rem;
      border: 2px solid var(--border-color);
      border-radius: 12px;
      background: var(--card-bg);
      color: var(--text-main);
      outline: none;
      transition: all 0.2s;
    }
    .search-input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    /* 파란색 검색 버튼 (검색창과 동일한 곡률 및 높이) */
    .search-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 1.5rem;
      font-size: 1rem;
      font-weight: 700;
      color: #ffffff;
      background-color: var(--primary); /* 기본 파란색 (#2563eb) */
      border: 2px solid var(--primary);
      border-radius: 12px;
      cursor: pointer;
      white-space: nowrap;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
      transition: all 0.15s ease-in-out;
    }

    /* 마우스 호버 및 클릭 액션 */
    .search-btn:hover {
      background-color: #1d4ed8; /* 약간 더 짙은 파란색 */
      border-color: #1d4ed8;
    }
    .search-btn:active {
      transform: scale(0.97);
    }

    /* 모바일 화면 여백 최적화 */
    @media (max-width: 640px) {
      .search-btn {
        padding: 0 1.1rem;
        font-size: 0.95rem;
      }
    }

      /* 검색 결과 영역 */
      .search-results {
        display: none;
        margin-bottom: 2rem;
      }
      .search-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
      }
      .search-count {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--text-sub);
      }
      .search-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr); /* 4열 -> 3열로 조정하여 텍스트 여유 공간 확보 */
        gap: 0.5rem;
      }
      .search-item {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.65rem 0.5rem;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 6px;
        text-decoration: none;
        color: #334155;
        font-size: 0.9rem;
        font-weight: 600;
        transition: all 0.15s;
      }
      .search-item:hover {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
      }
      .no-results {
        padding: 2rem;
        text-align: center;
        color: var(--text-sub);
        background: var(--card-bg);
        border-radius: 10px;
        border: 1px dashed var(--border-color);
      }

      /* 과목 탭 */
      .tabs { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; }
      .tab-btn {
        flex: 1;
        background: var(--card-bg);
        border: 2px solid var(--border-color);
        border-radius: 10px;
        padding: 0.8rem;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        color: var(--text-sub);
      }
      .tab-btn.active { background: var(--primary); color: white; border-color: var(--primary); }

      /* 시험 구분 서브 탭 */
      .type-tabs { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
      .type-btn {
        background: #e2e8f0;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        color: #475569;
      }
      .type-btn.active { background: #1e293b; color: white; }

      .panel { display: none; }
      .panel.active { display: block; }
      
      .year-list { display: flex; flex-direction: column; gap: 1rem; }
      .year-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 1rem 1.25rem;
      }
      .year-title { font-weight: 700; color: #334155; margin-bottom: 0.75rem; display: block; }
      .question-grid { display: grid; grid-template-columns: repeat(10, 1fr); gap: 0.4rem; }
      .q-btn {
        display: flex; align-items: center; justify-content: center;
        height: 36px; background: #f1f5f9; color: #475569;
        text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 0.9rem;
      }
      .q-btn:hover { background: var(--primary); color: white; }

      /* 푸터 스타일 */
      .site-footer {
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border-color);
        text-align: center;
        font-size: 0.85rem;
        color: var(--text-sub);
      }
      .site-footer .links { margin-bottom: 0.5rem; }
      .site-footer a { color: var(--primary); text-decoration: none; }

      @media (max-width: 640px) {
        .question-grid { grid-template-columns: repeat(5, 1fr); }
        .search-grid { grid-template-columns: 1fr; } /* 모바일에서는 1열로 배치하여 한 줄에 깔끔하게 표시 */
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <h1>
          <a href="/" class="site-title">전자직·통신직 기출문제 풀이 & 해설</a>
        </h1>
        <p style="color: var(--text-sub); margin-top: 0.4rem;">07~26년도 직렬별 기출 풀이집</p>
      </header>

      <!-- 키워드 검색창 -->
      <div class="search-wrapper">
        <input 
          type="text" 
          id="search-input" 
          class="search-input" 
          placeholder="키워드 검색 (예: 테브난, OP-Amp, 공진, 2018 국가직)" 
          autocomplete="off"
        />
        <button type="button" id="search-btn" class="search-btn">
          검색
        </button>
      </div>

      <!-- 검색 결과 표시 패널 -->
      <div id="search-results" class="search-results">
        <div class="search-header">
          <span id="search-count" class="search-count"></span>
        </div>
        <div id="search-grid" class="search-grid"></div>
        <div id="no-results" class="no-results" style="display: none;">검색 결과가 없습니다.</div>
      </div>

      <!-- 연도별 기출문제 목록 -->
      <div id="year-view">
        <!-- 과목 탭 -->
        <nav class="tabs">
          {subjects.map((sub, idx) => (
            <button class={`tab-btn ${idx === 0 ? 'active' : ''}`} data-subject={sub.id}>
              {sub.name}
            </button>
          ))}
        </nav>

        <!-- 과목별 컨텐츠 영역 -->
        {subjects.map((sub, sIdx) => (
          <section id={`subject-${sub.id}`} class={`panel ${sIdx === 0 ? 'active' : ''}`}>
            <!-- 시험 구분 서브 탭 -->
            <div class="type-tabs">
              {sub.types.map((t, tIdx) => (
                <button 
                  class={`type-btn ${tIdx === 0 ? 'active' : ''}`} 
                  data-target={`grid-${sub.id}-${t.id}`}
                >
                  {t.name}
                </button>
              ))}
            </div>

            <!-- 연도별 문제 그리드 -->
            {sub.types.map((t, tIdx) => (
              <div id={`grid-${sub.id}-${t.id}`} class={`panel ${tIdx === 0 ? 'active' : ''}`}>
                <div class="year-list">
                  {getYearsForSubjectAndType(sub.id, t.id).map((yr) => (
                    <div class="year-card">
                      <span class="year-title">{yr}년도 {sub.name} ({t.name})</span>
                      <div class="question-grid">
                        {Array.from({ length: 20 }, (_, i) => i + 1).map((qNum) => {
                          const paddedQ = String(qNum).padStart(2, '0');
                          return (
                            <a href={`/exams/${sub.id}/${t.id}/${yr}-${paddedQ}`} class="q-btn">
                              {qNum}
                            </a>
                          );
                        })}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </section>
        ))}
      </div>

      <footer class="site-footer">
        <p class="links">
          <a href="/privacy">개인정보처리방침</a>
        </p>
        <p class="copyright">© 2026 전기·전자·통신 공무원 기출 해설. All rights reserved.</p>
      </footer>
    </div>

    <!-- 검색용 데이터 전달 -->
    <script define:vars={{ searchIndex }}>
      window.__SEARCH_INDEX__ = searchIndex;
    </script>

    <script>
      // 요소 가져오기
      const searchInput = document.getElementById('search-input');
      const searchBtn = document.getElementById('search-btn');
      const searchResults = document.getElementById('search-results');
      const searchGrid = document.getElementById('search-grid');
      const searchCount = document.getElementById('search-count');
      const noResults = document.getElementById('no-results');
      const yearView = document.getElementById('year-view');

      const data = window.__SEARCH_INDEX__ || [];

      // 검색 실행 함수
      function performSearch(isInitialLoad = false) {
        const query = searchInput?.value.trim().toLowerCase();

        // 1. 검색어가 비어있는 경우
        if (!query) {
          if (searchResults) searchResults.style.display = 'none';
          if (yearView) yearView.style.display = 'block';
          // URL에서 쿼리스트링 제거
          if (!isInitialLoad) {
            history.replaceState(null, '', window.location.pathname);
          }
          return;
        }

        // 2. URL에 검색어 동기화 (?q=검색어)
        if (!isInitialLoad) {
          const newUrl = `${window.location.pathname}?q=${encodeURIComponent(searchInput.value.trim())}`;
          history.replaceState(null, '', newUrl);
        }

        // 화면 전환
        if (yearView) yearView.style.display = 'none';
        if (searchResults) searchResults.style.display = 'block';

        const keywords = query.split(/\s+/);
        const filtered = data.filter((item) => {
          const targetText = `${item.title} ${item.year} ${item.examType} ${item.questionNumber} ${item.subject} ${item.chapter} ${item.body}`.toLowerCase();
          return keywords.every((kw) => targetText.includes(kw));
        });

        if (filtered.length === 0) {
          if (searchGrid) searchGrid.innerHTML = '';
          if (searchCount) searchCount.textContent = '검색 결과 0건';
          if (noResults) noResults.style.display = 'block';
        } else {
          if (noResults) noResults.style.display = 'none';
          if (searchCount) searchCount.textContent = `검색 결과 ${filtered.length}건`;

          if (searchGrid) {
            searchGrid.innerHTML = filtered
              .map(
                (q) => `
                  <a href="/exams/${q.id}" class="search-item">
                    ${q.year} ${q.examType} ${q.subject} ${q.questionNumber}번
                  </a>
                `
              )
              .join('');
          }
        }
      }

      // 엔터 키 입력 시 검색
      searchInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          performSearch();
        }
      });

      // 검색 버튼 클릭 시 검색
      searchBtn?.addEventListener('click', () => performSearch());

      // 검색어를 지웠을 때 URL 및 화면 초기화
      searchInput?.addEventListener('input', (e) => {
        if (!e.target.value.trim()) {
          if (searchResults) searchResults.style.display = 'none';
          if (yearView) yearView.style.display = 'block';
          history.replaceState(null, '', window.location.pathname);
        }
      });

      // 뒤로가기 시 검색 상태 복원 (URL 쿼리스트링 감지)
      window.addEventListener('DOMContentLoaded', () => {
        const params = new URLSearchParams(window.location.search);
        const initialQuery = params.get('q');
        if (initialQuery && searchInput) {
          searchInput.value = initialQuery;
          performSearch(true);
        }
      });

      // 브라우저 뒤로가기/앞으로가기 히스토리 변동 감지
      window.addEventListener('popstate', () => {
        const params = new URLSearchParams(window.location.search);
        const currentQuery = params.get('q') || '';
        if (searchInput) {
          searchInput.value = currentQuery;
          performSearch(true);
        }
      });

      // 과목 탭 전환
      const subBtns = document.querySelectorAll('.tab-btn');
      subBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          subBtns.forEach((b) => b.classList.remove('active'));
          document.querySelectorAll('section.panel').forEach((p) => p.classList.remove('active'));
          btn.classList.add('active');
          const subId = btn.getAttribute('data-subject');
          document.getElementById(`subject-${subId}`)?.classList.add('active');
        });
      });

      // 직렬 서브탭 전환
      const typeBtns = document.querySelectorAll('.type-btn');
      typeBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const parent = btn.closest('section');
          parent?.querySelectorAll('.type-btn').forEach((b) => b.classList.remove('active'));
          parent?.querySelectorAll('div.panel').forEach((p) => p.classList.remove('active'));
          btn.classList.add('active');
          const targetId = btn.getAttribute('data-target');
          if (targetId) document.getElementById(targetId)?.classList.add('active');
        });
      });
    </script>
  </body>
</html>